# Local changes to ANGLE, as uncommitted edits on upstream commit
# 107da744f62a319b3c6851694740d9ebf247d048 GL: upload oversized mip levels through PBO.
# Apply with: git checkout 107da744f62a319b3c6851694740d9ebf247d048 && git apply angle-local-changes.patch
diff --git a/BUILD.gn b/BUILD.gn
index 0b6b06dcbb..06f07eb707 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -774,6 +774,10 @@ angle_static_library("angle_gpu_info_util") {
       sources += libangle_gpu_info_util_mac_sources
     }
     if (is_ios && !angle_enable_cgl) {
+      # Cabinet-local: the Catalyst build compiles the Mac side of
+      # apple_platform_utils, which calls IOKit; upstream only links it
+      # for is_mac. Harmless where unused.
+      frameworks += [ "IOKit.framework" ]
       sources += libangle_gpu_info_util_ios_sources
     }
   }
diff --git a/src/libANGLE/renderer/metal/ContextMtl.h b/src/libANGLE/renderer/metal/ContextMtl.h
index 4ea4a3cc12..1b0b010cf2 100644
--- a/src/libANGLE/renderer/metal/ContextMtl.h
+++ b/src/libANGLE/renderer/metal/ContextMtl.h
@@ -339,6 +339,7 @@ class ContextMtl : public ContextImpl, public mtl::Context
     void endEncoding(bool forceSaveRenderPassContent);
 
     void flushCommandBuffer(mtl::CommandBufferFinishOperation operation);
+    mtl::CommandBuffer &getCommandBuffer() { return mCmdBuffer; }
     void present(const gl::Context *context, id<CAMetalDrawable> presentationDrawable);
     angle::Result finishCommandBuffer();
 
diff --git a/src/libANGLE/renderer/metal/mtl_buffer_pool.mm b/src/libANGLE/renderer/metal/mtl_buffer_pool.mm
index ce6d0a3e8a..a902a9d7ec 100644
--- a/src/libANGLE/renderer/metal/mtl_buffer_pool.mm
+++ b/src/libANGLE/renderer/metal/mtl_buffer_pool.mm
@@ -303,6 +303,18 @@ void UpdateBufferPoolMetrics(int64_t totalMemoryDelta,
         // commit() already flushes so no need to flush here.
         mBuffer->unmapNoFlush(contextMtl);
 
+        // Conservatively mark the retiring buffer as used by the current
+        // command buffer. Draws recorded in the open pass may reference
+        // slices of this buffer, but under heavy client-vertex streaming
+        // the buffer can reach the free list reading as idle and be
+        // remapped at offset 0 while those draws are still pending,
+        // which renders as garbage primitives (deterministic repro:
+        // mupen64plus/GLideN64 unbuffered streaming on Apple GPUs).
+        // Stamping with the current serial quarantines it until this
+        // command buffer completes, after which normal reuse resumes.
+        mBuffer->setUsedByCommandBufferWithQueueSerial(
+            contextMtl->getCommandBuffer().getQueueSerial(), false, true);
+
         mInFlightBuffers.push_back(mBuffer);
         mBuffer = nullptr;
     }
diff --git a/src/libANGLE/renderer/metal/mtl_utils.mm b/src/libANGLE/renderer/metal/mtl_utils.mm
index 6912d1cf0d..6491c051a3 100644
--- a/src/libANGLE/renderer/metal/mtl_utils.mm
+++ b/src/libANGLE/renderer/metal/mtl_utils.mm
@@ -284,7 +284,11 @@ uint32_t GetDeviceVendorIdFromName(id<MTLDevice> metalDevice)
     }
 }
 
-#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
+#if TARGET_OS_OSX && !TARGET_OS_MACCATALYST
+// Catalyst deliberately excluded, a Cabinet-local change: the gn build
+// gives Catalyst the iOS gpu_info sources, which do not carry
+// GetVendorIDFromMetalDeviceRegistryID, and on Apple silicon the
+// name-based fallback below answers identically.
 uint32_t GetDeviceVendorIdFromIOKit(id<MTLDevice> device)
 {
     return angle::GetVendorIDFromMetalDeviceRegistryID(device.registryID);
@@ -823,7 +827,7 @@ MTLScissorRect GetScissorRect(const gl::Rectangle &rect, NSUInteger screenHeight
 uint32_t GetDeviceVendorId(id<MTLDevice> metalDevice)
 {
     uint32_t vendorId = 0;
-#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
+#if TARGET_OS_OSX && !TARGET_OS_MACCATALYST
     vendorId = GetDeviceVendorIdFromIOKit(metalDevice);
 #endif
     if (!vendorId)
